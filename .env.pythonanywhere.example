# Generate the real .env with: python3.13 scripts/configure_pythonanywhere.py
DJANGO_SECRET_KEY=replace-with-a-generated-secret
DEBUG=False
PYTHONANYWHERE_USERNAME=YOUR_PYTHONANYWHERE_USERNAME
PUBLIC_PROXY_HOST=aura.ahmedalghary1.workers.dev
ALLOWED_HOSTS=YOUR_PYTHONANYWHERE_USERNAME.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=https://YOUR_PYTHONANYWHERE_USERNAME.pythonanywhere.com,https://aura.ahmedalghary1.workers.dev

# The database and its backups stay outside the Git repository deliberately.
PYTHONANYWHERE_DATA_ROOT=/home/YOUR_PYTHONANYWHERE_USERNAME/cosmetics_data
SQLITE_PATH=/home/YOUR_PYTHONANYWHERE_USERNAME/cosmetics_data/db.sqlite3
SQLITE_TIMEOUT=20
SQLITE_ENABLE_WAL=False
STATIC_ROOT=/home/YOUR_PYTHONANYWHERE_USERNAME/Cosmetics/staticfiles
MEDIA_ROOT=/home/YOUR_PYTHONANYWHERE_USERNAME/Cosmetics/media
PRIVATE_MEDIA_ROOT=/home/YOUR_PYTHONANYWHERE_USERNAME/Cosmetics/private_media
SERVE_MEDIA_FILES=True
CACHE_BACKEND=django.core.cache.backends.filebased.FileBasedCache
CACHE_LOCATION=/home/YOUR_PYTHONANYWHERE_USERNAME/cosmetics_data/cache

SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
LOG_LEVEL=WARNING

# SMTP is required for real password-reset mail. These Gmail values also work
# with Google Workspace; use an App Password, never the normal account password.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL=اسم المتجر <your-email@gmail.com>
SERVER_EMAIL=اسم المتجر <your-email@gmail.com>
PASSWORD_RESET_TIMEOUT=3600
